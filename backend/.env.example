# Server
PORT=3000

# PostgreSQL — adjust host, port, and credentials to match your local installation
DB_HOST=localhost
DB_PORT=5432

# replace with your actual PostgreSQL username
DB_USERNAME=your_postgres_username 

# replace with your actual PostgreSQL password
DB_PASSWORD=your_postgres_password 

DB_NAME=timeoff

# JWT — replace with a long random string in any real environment
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=24h
